{
  "name": "clipforge-desktop",
  "productName": "ClipForge",
  "version": "0.3.0",
  "description": "ClipForge auto clipper desktop",
  "author": "ClipForge",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:app": "bash prepare.sh",
    "dist": "bash prepare.sh && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@distube/ytdl-core": "^4.16.12",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clipforge.desktop",
    "productName": "ClipForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "app/server/face_track.py"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon.icns",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Install ClipForge",
      "icon": "build/icon.icns",
      "iconSize": 112,
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "extraResources": [
      {
        "from": "resources/yt-dlp",
        "to": "yt-dlp"
      }
    ],
    "artifactName": "ClipForge-${version}-${arch}.${ext}",
    "afterPack": "build/afterPack.cjs"
  }
}
